{
  "version": 2,
  "outputDirectory": ".",
  "devCommand": "node server.mjs",
  "functions": {
    "api/**/*.js": {
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
