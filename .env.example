# ── Resend (email delivery) ──
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must use a verified domain in Resend.
# Format: "Name <localpart@yourdomain.com>"
RESEND_FROM="Me <hello@yourdomain.com>"

# ── Resend Audience (newsletter / waitlist list) ──
# Create an Audience in Resend dashboard → Contacts → Audiences,
# then paste its ID here. Contacts are de-duplicated by email automatically.
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Optional: internal notification on each new signup ──
# If set, you'll get an email ping every time someone joins the waitlist.
WAITLIST_NOTIFY_TO=you@yourdomain.com
